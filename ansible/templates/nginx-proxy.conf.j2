# templates/nginx-proxy.conf.j2
#
# Nginx reverse-proxy configuration for the Side-Quest Board.
# Rendered by Ansible and placed at:
#   /etc/nginx/sites-available/{{ nginx_site_name }}
#
# Traffic routing:
#   /api/*  →  Spring Boot backend  (localhost:{{ backend_port }})
#   /*      →  React frontend       (localhost:{{ frontend_port }})

server {
    listen 80;
    server_name {{ ansible_host }} _;

    # ── Logging ────────────────────────────────────────────────────────────
    access_log /var/log/nginx/{{ nginx_site_name }}-access.log;
    error_log  /var/log/nginx/{{ nginx_site_name }}-error.log warn;

    # ── API: proxy all /api/* requests to Spring Boot ─────────────────────
    location /api/ {
        proxy_pass         http://127.0.0.1:{{ backend_port }}/api/;
        proxy_http_version 1.1;

        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;

        # Spring Boot can be slow on cold start; give it time.
        proxy_connect_timeout 30s;
        proxy_read_timeout    60s;
        proxy_send_timeout    60s;
    }

    # ── Frontend: proxy everything else to the React/Vite Nginx container ─
    location / {
        proxy_pass         http://127.0.0.1:{{ frontend_port }}/;
        proxy_http_version 1.1;

        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;

        # Support client-side routing in React (SPA fallback)
        proxy_intercept_errors on;
        error_page 404 = /index.html;
    }

    # ── Health check endpoint (used by Docker and Jenkins) ─────────────────
    location /health {
        access_log off;
        return 200 'ok\n';
        add_header Content-Type text/plain;
    }
}
