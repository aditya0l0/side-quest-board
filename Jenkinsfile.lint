/*
 * DOWNSTREAM JOB: sidequest-lint
 *
 * Triggered by:  sidequest-master  (Jenkinsfile)
 * Script Path:   Jenkinsfile.lint
 *
 * Runs Checkstyle on the Spring Boot backend and oxlint on the React frontend
 * inside isolated Docker worker containers. Both linters must pass for this
 * job to succeed; either failure reports FAILURE back to the master.
 *
 * Parameters (injected by master):
 *   UPSTREAM_BUILD_NUMBER  – the master's BUILD_NUMBER (used for image/container names)
 *   PIPELINE_NETWORK       – the Docker bridge network created by the master
 */
pipeline {
    agent any

    options {
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 10, unit: 'MINUTES')
    }

    parameters {
        string(
            name: 'UPSTREAM_BUILD_NUMBER',
            defaultValue: '',
            description: 'BUILD_NUMBER of the upstream sidequest-master job'
        )
        string(
            name: 'PIPELINE_NETWORK',
            defaultValue: '',
            description: 'Isolated Docker bridge network created by the master'
        )
        // ── Webhook trigger context (forwarded by master, empty when manual) ──
        string(
            name: 'GITHUB_ISSUE_NUMBER',
            defaultValue: '',
            description: 'GitHub issue number that triggered this build'
        )
        string(
            name: 'GITHUB_ISSUE_TITLE',
            defaultValue: '',
            description: 'GitHub issue title for log context'
        )
        string(
            name: 'GITHUB_PR_NUMBER',
            defaultValue: '',
            description: 'GitHub pull request number that triggered this build'
        )
        string(
            name: 'GITHUB_PR_TITLE',
            defaultValue: '',
            description: 'GitHub pull request title for log context'
        )
        string(
            name: 'GITHUB_PR_SHA',
            defaultValue: '',
            description: 'GitHub pull request head commit SHA to check out'
        )
        string(
            name: 'GITHUB_PR_HEAD_REF',
            defaultValue: '',
            description: 'GitHub pull request head branch ref'
        )
        string(
            name: 'TRIGGERED_BY',
            defaultValue: 'manual',
            description: 'Trigger source: "github-issue-webhook" | "github-pr-webhook" | "manual"'
        )
    }

    stages {
        stage('Validate & Checkout') {
            steps {
                script {
                    if (!params.UPSTREAM_BUILD_NUMBER || !params.PIPELINE_NETWORK) {
                        error("[LINT] Required parameters missing. This job must be triggered by sidequest-master, not run directly.")
                    }
                    if (params.TRIGGERED_BY == 'github-pr-webhook' || params.TRIGGERED_BY == 'github-comment-webhook') {
                        echo "=== [LINT] Triggered by GitHub PR #${params.GITHUB_PR_NUMBER} via ${params.TRIGGERED_BY}: \"${params.GITHUB_PR_TITLE}\" (SHA: ${params.GITHUB_PR_SHA}) ==="
                        if (params.GITHUB_PR_SHA) {
                            echo "=== [LINT] Checking out PR head commit: ${params.GITHUB_PR_SHA} ==="
                            sh "git fetch origin ${params.GITHUB_PR_SHA} && git checkout -f ${params.GITHUB_PR_SHA}"
                        } else if (params.GITHUB_PR_NUMBER) {
                            echo "=== [LINT] Checking out PR #${params.GITHUB_PR_NUMBER} head ref ==="
                            sh "git fetch origin pull/${params.GITHUB_PR_NUMBER}/head && git checkout -f FETCH_HEAD"
                        }
                    } else if (params.TRIGGERED_BY == 'github-issue-webhook') {
                        echo "=== [LINT] Triggered by GitHub Issue #${params.GITHUB_ISSUE_NUMBER}: \"${params.GITHUB_ISSUE_TITLE}\" ==="
                    }
                }
            }
        }

        stage('Lint Backend') {
            steps {
                echo "=== [LINT] Running Checkstyle on backend (upstream build #${params.UPSTREAM_BUILD_NUMBER}) ==="
                sh """
                    docker run --rm \\
                        --name lint-backend-${params.UPSTREAM_BUILD_NUMBER} \\
                        --network ${params.PIPELINE_NETWORK} \\
                        --volumes-from jenkins \\
                        -w ${WORKSPACE}/backend \\
                        maven:3.9.7-eclipse-temurin-17 \\
                        mvn --no-transfer-progress checkstyle:check
                """
                echo "=== [LINT] Backend Checkstyle PASSED ==="
            }
        }

        stage('Lint Frontend') {
            steps {
                echo "=== [LINT] Running oxlint on frontend (upstream build #${params.UPSTREAM_BUILD_NUMBER}) ==="
                sh """
                    docker run --rm \\
                        --name lint-frontend-${params.UPSTREAM_BUILD_NUMBER} \\
                        --network ${params.PIPELINE_NETWORK} \\
                        --volumes-from jenkins \\
                        -w ${WORKSPACE}/frontend \\
                        node:20-alpine \\
                        sh -c "npm ci --prefer-offline && npm run lint"
                """
                echo "=== [LINT] Frontend oxlint PASSED ==="
            }
        }
    }

    post {
        success {
            echo "=== [LINT] All linters PASSED — reporting SUCCESS to master ==="
        }
        failure {
            echo "=== [LINT] One or more linters FAILED — reporting FAILURE to master ==="
        }
    }
}
