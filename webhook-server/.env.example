# ──────────────────────────────────────────────────────────────────────────────
# GitHub Issues → Jenkins Webhook Server — Environment Variables
#
# Copy this file to .env and fill in every value.
# NEVER commit .env to source control.
# ──────────────────────────────────────────────────────────────────────────────

# Port the Express server listens on inside the container.
PORT=3000

# Secret you set in GitHub → Settings → Webhooks → Secret.
# The receiver uses this to verify the X-Hub-Signature-256 header.
GITHUB_WEBHOOK_SECRET=replace_with_a_long_random_string

# Base URL of your Jenkins instance (reachable from inside Docker).
# When running in the same docker-compose stack use the service name:
#   JENKINS_URL=http://jenkins:8080
JENKINS_URL=http://jenkins:8080

# Jenkins user that owns the API token below.
JENKINS_USER=admin

# Jenkins API token — generate one at:
#   Jenkins UI → <Your Username> → Configure → API Token → Add new Token
JENKINS_API_TOKEN=replace_with_your_jenkins_api_token
