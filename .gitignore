target/
**/target/
**/node_modules/
**/dist/
.idea/
*.class

# Webhook server secrets — NEVER commit these
webhook-server/.env

# Agent tracking & context files
AGENTS.md
PROGRESS.md

# ── Terraform ──────────────────────────────────────────────────────────────────
# Provider plugins downloaded by `terraform init` (600MB+ binaries — exceeds GitHub 100MB limit)
terraform/.terraform/

# Local state files — contain sensitive credentials and resource IDs
terraform/terraform.tfstate
terraform/terraform.tfstate.backup

# Plan output binaries
terraform/tfplan-*.bin

# ── Packer ─────────────────────────────────────────────────────────────────────
# Local plugin cache created by `packer init`
packer/packer_cache/

# Manifest written after each bake (changes every run; AMI ID committed to tfvars instead)
packer/manifest.json
